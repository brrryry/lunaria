{
  "name": "lunaria",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "turbo run clean && rm -rf node_modules",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "infra:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "deploy:nas": "bash ./scripts/deploy-nas.sh",
    "db:push": "pnpm --filter @lunaria/db db:push",
    "db:seed": "pnpm --filter @lunaria/db db:seed",
    "seed": "pnpm --filter @lunaria/db db:seed",
    "db:clear": "pnpm --filter @lunaria/db db:clear",
    "clear": "pnpm --filter @lunaria/db db:clear",
    "mobile": "pnpm --filter @lunaria/mobile dev",
    "mobile:web": "pnpm --filter @lunaria/mobile web"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "jsonwebtoken": "^9.0.3",
    "plaid": "^28.0.0",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.12.1"
}
