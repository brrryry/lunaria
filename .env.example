# Database (PostgreSQL + TimescaleDB running via Docker on port 5432)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lunaria
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lunaria

# Redis Cache & BullMQ (running via Docker on port 6379)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Plaid API
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=http://localhost:3001/api/plaid/webhook

# Polygon.io (Stocks/Investments)
POLYGON_API_KEY=your_polygon_api_key

# Security & Encryption (AES-256-GCM for Plaid tokens)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Backend API
PORT=3001
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Next.js Web App
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Google OAuth 2.0 & JWT Session
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
JWT_SECRET=lunaria-super-secret-jwt-key-change-in-production
# Allowed email whitelist (comma-separated). If set, only matching emails can log in.
AUTH_WHITELIST_EMAILS=
# Development auth bypass (DO NOT enable in production)
ALLOW_DEV_AUTH_BYPASS=false

# Resend Email Integration (https://resend.com)
RESEND_API_KEY=re_your_api_key_here
# Free plan test sender is onboarding@resend.dev (delivers to your registered Resend email)
RESEND_FROM_EMAIL=onboarding@resend.dev

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:support@lunaria.money
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key

